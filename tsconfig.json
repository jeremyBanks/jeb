{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020", "ESNext"],
    "module": "ESNext",
    "noEmit": true,
    "moduleResolution": "node",
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "rootDir": "./",
    "strict": true,
    "target": "ESNext"
  },
  "exclude": ["node_modules", "worker", "dist"],
  "include": ["./**/*.js"]
}
