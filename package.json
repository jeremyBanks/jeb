{
  "dependencies": {
    "@cloudflare/wrangler": "^1.11.0",
    "http-server": "^0.12.3",
    "json5": "^2.1.3",
    "prettier": "v2.0.5",
    "replace-in-files-cli": "v0.3.1",
    "sort-json": "v2",
    "typescript": "^4.0.2",
    "web-ext": "^4.2.0"
  },
  "main": "./stadia.run/-/edge-worker.js",
  "name": "stadians.dev",
  "prettier": {
    "arrowParens": "avoid",
    "overrides": [
      {
        "files": ["*.yml", "*.yaml", "*.json"],
        "options": {
          "parser": "json",
          "trailingComma": "none"
        }
      }
    ],
    "trailingComma": "all"
  },
  "private": true,
  "resolutions": {
    "web-ext/**/shelljs": ">=0.8.4"
  },
  "type": "module",
  "version": "2020.9.13"
}
