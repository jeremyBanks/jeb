#!/bin/bash
#
# A wrapper around `cargo run`-like behavior, but falling back to existing
# builds or system installations of tools, if we aren't able to (re)build a
# local copy. This is to mitigate the pain of self-hosting tools inside of our
# own workspace, where changes we're making might break our ability to build
# the tools we want to use while continuing to work on fixing that code!
#
# Therefore any binary implemented in this workspace that we're running as part
# of our workflow (not for the sake of developing/testing them, but to use them
# for their intended purpose) should be run through `./run <command> <args...>`.
# instead of `cargo run --bin <command> -- <args...>`. `./run save` will be
# common.

set -euo pipefail
declare command="$1"
shift
declare bin=""

# XXX: These should all be empty strings unless is a tty, and not NO_COLORS
declare DARK_GRAY_BACKGROUND=""
declare RESET=""
declare WHITE=""
declare BROWN=""
declare YELLOW=""
declare BLUE=""
declare CYAN=""
declare MAGENTA=""
declare RED=""

if [ -t 2 ] && [ -z "${NO_COLORS-}" ]; then
    DARK_GRAY_BACKGROUND=$'\033[1;40m\033[K'
    RESET=$'\033[0m'
    WHITE=$'\033[1;37m'
    BROWN=$'\033[1;33m'
    YELLOW=$'\033[1;33m'
    BLUE=$'\033[1;34m'
    CYAN=$'\033[1;36m'
    MAGENTA=$'\033[1;35m'
    RED=$'\033[1;31m'
fi

declare -r DARK_GRAY_BACKGROUND
declare -r RESET
declare -r WHITE
declare -r BROWN
declare -r YELLOW
declare -r BLUE
declare -r CYAN
declare -r MAGENTA
declare -r RED

echo >&2 -e "${DARK_GRAY_BACKGROUND}"
echo >&2 -e "${DARK_GRAY_BACKGROUND}${MAGENTA}  \$${WHITE} ${BROWN}cargo build --bin${WHITE} ${CYAN}$command${WHITE}"
echo >&2 -e "${DARK_GRAY_BACKGROUND}"
echo >&2 -ne "${RESET}"

if ! cargo build --bin "$command"; then
    echo >&2 "${YELLOW}WARNING:${WHITE} Failed to build \`${command}\`. Falling back to existing debug build."
fi

if [ -x "./target/debug/$command" ]; then
    bin="./target/debug/$command"
elif [ -x "./target/release/$command" ]; then
    echo >&2 "${YELLOW}WARNING:${WHITE} Existing debug build not found. Falling back to release build."
    bin="./target/release/$command"
else
    echo >&2 "${YELLOW}WARNING:${WHITE} Existing builds not found. Falling back to \`cargo install\`ed binary."

    if [ -x "$HOME/.cargo/bin/$command" ]; then
        bin="$HOME/.cargo/bin/$command"
    else
        echo >&2 "${YELLOW}WARNING:${WHITE} \`cargo install\`ed binary not found for \`${command}\`. Falling back to any matching command."

        if type "$command" >/dev/null 2>&1; then
            bin="$command"
        else
            echo >&2 "${RED}ERROR:${WHITE} No matching command found for \`${command}\`. Giving up."
            exit 1
        fi
    fi
fi

echo >&2 -e "${DARK_GRAY_BACKGROUND}"
echo >&2 -e "${DARK_GRAY_BACKGROUND}  ${MAGENTA}\$${WHITE} ${CYAN}$bin${WHITE} ${BLUE}$@${WHITE}"
echo >&2 -e "${DARK_GRAY_BACKGROUND}"
echo >&2 -ne "${RESET}"

exec "$bin" "$@"
