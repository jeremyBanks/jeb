{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "JEB85",
  "scopeName": "source.jeb85",
  "patterns": [{
    "comment": "raw to EOF",
    "contentName": "string.jeb",
    "begin": "(0\\|)",
    "beginCaptures": {
      "1": { "name": "keyword.jeb" }
    },
    "end": "$"
  }, {
    "comment": "raw block",
    "match": "(\\|)((.{4}|.{1,3}$){1,1})",
    "captures": {
      "1": { "name": "keyword.jeb" },
      "2": { "name": "string.jeb" }
    }
  }, {
    "comment": "2 raw blocks",
    "match": "(1)(\\|)(.{3,8})",
    "0,captures": {
      "1": { "name": "keyword.jeb" },
      "2": { "name": "keyword.jeb" },
      "3": { "name": "string.jeb" }
    }
  }, {
    "comment": "3 raw blocks",
    "match": "(2)(\\|)(.{3,12})(.{0,1})",
    "captures": {
      "1": { "name": "keyword.jeb" },
      "2": { "name": "keyword.jeb" },
      "3": { "name": "string.jeb" },
      "4": { "name": "string.padding.jeb" }
    }
  }, {
    "comment": "4 raw blocks",
    "match": "(3)(\\|)(.{3,16})(.{0,2})",
    "captures": {
      "1": { "name": "keyword.jeb" },
      "2": { "name": "keyword.jeb" },
      "3": { "name": "string.jeb" },
      "4": { "name": "string.padding.jeb" }
    }
  }, {
    "comment": "5 raw blocks",
    "match": "(4)(\\|)(.{3,20})(.{0,3})",
    "captures": {
      "1": { "name": "keyword.jeb" },
      "2": { "name": "keyword.jeb" },
      "3": { "name": "string.jeb" },
      "4": { "name": "string.padding.jeb" }
    }
  }, {
    "comment": "6 raw blocks",
    "match": "(5)(\\|)(.{3,24})(.{0,4})",
    "captures": {
      "1": { "name": "keyword.jeb" },
      "2": { "name": "keyword.jeb" },
      "3": { "name": "string.jeb" },
      "4": { "name": "string.padding.jeb" }
    }
  }, {
    "comment": "7 raw blocks",
    "match": "(6)(\\|)(.{3,28})(.{0,5})",
    "captures": {
      "1": { "name": "keyword.jeb" },
      "2": { "name": "keyword.jeb" },
      "3": { "name": "string.jeb" },
      "4": { "name": "string.padding.jeb" }
    }
  }, {
    "comment": "8 raw blocks",
    "match": "(7)(\\|)(.{3,32})(.{0,6})",
    "captures": {
      "1": { "name": "keyword.jeb" },
      "2": { "name": "keyword.jeb" },
      "3": { "name": "string.jeb" },
      "4": { "name": "string.padding.jeb" }
    }
  }, {
    "comment": "9 raw blocks",
    "match": "(8)(\\|)(.{3,36})(.{0,7})",
    "captures": {
      "1": { "name": "keyword.jeb" },
      "2": { "name": "keyword.jeb" },
      "3": { "name": "string.jeb" },
      "4": { "name": "string.padding.jeb" }
    }
  }, {
    "comment": "10 raw blocks",
    "match": "(9)(\\|)(.{3,40})(.{0,8})",
    "captures": {
      "1": { "name": "keyword.jeb" },
      "2": { "name": "keyword.jeb" },
      "3": { "name": "string.jeb" },
      "4": { "name": "string.padding.jeb" }
    }
  }, {
    "comment": "11 raw blocks",
    "match": "(a)(\\|)(.{3,44})(.{0,9})",
    "captures": {
      "1": { "name": "keyword.jeb" },
      "2": { "name": "keyword.jeb" },
      "3": { "name": "string.jeb" },
      "4": { "name": "string.padding.jeb" }
    }
  }, {
    "comment": "12 raw blocks",
    "match": "(b)(\\|)(.{3,48})(.{0,10})",
    "captures": {
      "1": { "name": "keyword.jeb" },
      "2": { "name": "keyword.jeb" },
      "3": { "name": "string.jeb" },
      "4": { "name": "string.padding.jeb" }
    }
  }, {
    "comment": "13 raw blocks",
    "match": "(c)(\\|)(.{3,52})(.{0,11})",
    "captures": {
      "1": { "name": "keyword.jeb" },
      "2": { "name": "keyword.jeb" },
      "3": { "name": "string.jeb" },
      "4": { "name": "string.padding.jeb" }
    }
  }, {
    "comment": "14 raw blocks",
    "match": "(d)(\\|)(.{3,56})(.{0,12})",
    "captures": {
      "1": { "name": "keyword.jeb" },
      "2": { "name": "keyword.jeb" },
      "3": { "name": "string.jeb" },
      "4": { "name": "string.padding.jeb" }
    }
  }, {
    "comment": "15 raw blocks",
    "match": "(e)(\\|)(.{3,60})(.{0,13})",
    "captures": {
      "1": { "name": "keyword.jeb" },
      "2": { "name": "keyword.jeb" },
      "3": { "name": "string.jeb" },
      "4": { "name": "string.padding.jeb" }
    }
  }, {
    "comment": "16 raw blocks",
    "match": "(f)(\\|)(.{3,64})(.{0,14})",
    "captures": {
      "1": { "name": "keyword.jeb" },
      "2": { "name": "keyword.jeb" },
      "3": { "name": "string.jeb" },
      "4": { "name": "string.padding.jeb" }
    }
  }, {
    "comment": "17+ too many raw blocks",
    "match": "([0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\\.\\-\\:\\+\\=\\^\\!\\/\\*\\?\\&\\<\\>\\(\\)\\[\\]\\{\\}\\@\\%\\$\\#]{1,4})(\\|)([^.]{3}.{1,79})",
    "captures": {
      "1": { "name": "keyword.jeb" },
      "2": { "name": "keyword.jeb" },
      "3": { "name": "string.jeb" }
    }
  }, {
    "comment": "all 4 zeros Z85 block",
    "name": "constant.numeric.padding.jeb",
    "match": "00000"
  }, {
    "comment": "4 leading zeros Z85 block",
    "match": "(0{4})([0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\\.\\-\\:\\+\\=\\^\\!\\/\\*\\?\\&\\<\\>\\(\\)\\[\\]\\{\\}\\@\\%\\$\\#]{1})",
    "captures": {
      "1": { "name": "constant.numeric.padding.jeb" },
      "2": { "name": "constant.numeric.jeb" }
    }
  }, {
    "comment": "3 leading zeros Z85 block",
    "match": "(0{3})([0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\\.\\-\\:\\+\\=\\^\\!\\/\\*\\?\\&\\<\\>\\(\\)\\[\\]\\{\\}\\@\\%\\$\\#]{2})",
    "captures": {
      "1": { "name": "constant.numeric.padding.jeb" },
      "2": { "name": "constant.numeric.jeb" }
    }
  }, {
    "comment": "2 leading zeros Z85 block",
    "match": "(0{2})([0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\\.\\-\\:\\+\\=\\^\\!\\/\\*\\?\\&\\<\\>\\(\\)\\[\\]\\{\\}\\@\\%\\$\\#]{3})",
    "captures": {
      "1": { "name": "constant.numeric.padding.jeb" },
      "2": { "name": "constant.numeric.jeb" }
    }
  }, {
    "comment": "leading zero Z85 block",
    "match": "(0{1})([0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\\.\\-\\:\\+\\=\\^\\!\\/\\*\\?\\&\\<\\>\\(\\)\\[\\]\\{\\}\\@\\%\\$\\#]{4})",
    "captures": {
      "1": { "name": "constant.numeric.padding.jeb" },
      "2": { "name": "constant.numeric.jeb" }
    }
  }, {
    "comment": "prelude",
    "name": "comment.prelude.jeb",
    "begin": "^#!/",
    "end": "^.*jeb.*$"
  }, {
    "comment": "Z85 block",
    "name": "constant.numeric.jeb",
    "match": "[0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\\.\\-\\:\\+\\=\\^\\!\\/\\*\\?\\&\\<\\>\\(\\)\\[\\]\\{\\}\\@\\%\\$\\#]{5}"
  }, {
    "comment": "Z85 block truncated at EOF",
    "name": "constant.numeric.jeb",
    "match": "[0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\\.\\-\\:\\+\\=\\^\\!\\/\\*\\?\\&\\<\\>\\(\\)\\[\\]\\{\\}\\@\\%\\$\\#]{1,4}$"
  }, {
    "comment": "probably padding",
    "name": "string.padding.jeb",
    "match": "\\.\\.\\.\\.\\."
  }, {
    "comment": "unknown, assumed raw",
    "name": "string.jeb",
    "match": ".{5}|.{1,4}$"
  }]
}
