#!/usr/bin/env bash
set -euo pipefail
shopt -s inherit_errexit extglob nullglob compat"${BASH_COMPAT=42}"
cd "$(dirname "${BASH_SOURCE}")"

declare source="$PWD/stadia.run/index.html"
declare target="$PWD/stadia.run/-/index.js"

rm -rf "$target"
echo "/** @generated from index.html */" > "$target"
echo >> "$target"
sed -n -e '/<script type="module">/,/<\/script>/ p' "$source" | sed -e '1d;$d' >> "$target"

rm -rf "./stadia.run/-/json5.js"
echo "// @ts-nocheck @generated from node_modules/json5" > "./stadia.run/-/json5.js"
tail -n +2 "./node_modules/json5/dist/index.mjs" >> "./stadia.run/-/json5.js"

jq < "./stadia.st/-/records.json" '. | with_entries( select(.value.type == "avatar" ) )' > "./stadia.st/-/avatars.json"
jq < "./stadia.st/-/records.json" '. | with_entries( select(.value.type == "game" ) )' > "./stadia.st/-/games.json"
jq < "./stadia.st/-/records.json" '. | with_entries( select(.value.type == "user" ) )' > "./stadia.st/-/users.json"
jq < "./stadia.st/-/records.json" '. | with_entries( select(.value.type == "list" ) )' > "./stadia.st/-/lists.json"

yarn replace-in-files --regex='"version"\s*:\s*"(.*?)"' --replacement='"version": "'"$(date "+%Y.%-m.%-d")"'"' "./package.json" "./extension/manifest.json"
yarn replace-in-files --regex='"version_name"\s*:\s*"(.*?)"' --replacement='"version_name": "'"$(date "+%Y-%m-%d")"'"' "./extension/manifest.json"
yarn sort-json .vscode/**/*.json .github/**/*.{json,yml,yaml} ./*.json ./stadia.run/-/**.json ./stadia.st/-/**.json

yarn prettier --write "./"*".json" "./stadia."*"/-/" "./.vscode/" "./extension/"**/*.js "./.github/"

# we want to discourage users from editing these, but
# need to let prettier do its thing first.
chmod -w "./stadia.run/-/json5.js"
chmod -w "$target"

yarn tsc || :

brotli -f "./stadia.run/index.html"
declare size
size="$(wc -c <"./stadia.run/index.html.br")"
declare target=24576
declare percentage
percentage="$((size * 100 / target))"
echo "./stadia.run/index.html.br is at $percentage% of maximum size."
if [[ "$percentage" -ge 90 ]]; then
  echo "That's too damn high!"
  exit 1
fi
