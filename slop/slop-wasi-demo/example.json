{
  "name": "slop-wasi-demo",
  "description": "A demonstration of WASI-compatible Rust CLI for Deno",
  "features": [
    "Single-threaded async runtime",
    "Cross-platform WASM distribution",
    "File and stdin/stdout support",
    "JSON processing"
  ],
  "compatibility": {
    "wasi": "Preview 1",
    "target": "wasm32-wasip1",
    "runtime": "Deno"
  },
  "limitations": [
    "No networking",
    "No multi-threading",
    "No subprocess spawning"
  ]
}
