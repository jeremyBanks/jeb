  "[json][jsonc][javascript][javascriptreact][typescript][typescriptreact]": {
    "editor.defaultFormatter": "denoland.vscode-deno",
    "editor.tabSize": 2
  },
  "[markdown]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  },
  "chat.useClaudeSkills": true,
  "cSpell.enabledNotifications": {
    "Average Word Length too Long": false,
    "Lines too Long": false,
    "Maximum Word Length Exceeded": false
  },
  "cSpell.words": [
    "backticked",
    "bindgen",
    "binstall",
    "bstr",
    "cdylib",
    "CLAUDECODE",
    "clippy",
    "codegen",
    "databake",
    "debuginfo",
    "delegators",
    "denoland",
    "DONOTMERGE",
    "DONOTREVIEW",
    "DONOTSUBMIT",
    "dotenv",
    "elif",
    "errorlens",
    "externref",
    "externrefs",
    "fuckit",
    "getset",
    "HISTCONTROL",
    "HISTFILESIZE",
    "HISTSIZE",
    "ignoreboth",
    "indexmap",
    "libjeb",
    "mergeoptions",
    "miri",
    "mktree",
    "newtype",
    "peekable",
    "pipefail",
    "pushd",
    "realpath",
    "redirections",
    "remappings",
    "repr",
    "reqwest",
    "reserialize",
    "rustc",
    "RUSTFLAGS",
    "rustup",
    "scattersquare",
    "serde",
    "shellcheck",
    "signedness",
    "stefanzweifel",
    "subnormals",
    "subshell",
    "tiebreaking",
    "timonwong",
    "tlsv",
    "toplevel",
    "trunc",
    "usernamehw",
    "USERPROFILE",
    "vadimcn",
    "vecs",
    "veuo",
    "vexu",
    "wasmbuild",
    "wbindgen"
  ],
  "editor.detectIndentation": false,
  "editor.formatOnSave": true,
  "editor.indentSize": "tabSize",
  "editor.renderWhitespace": "boundary",
  "editor.rulers": [
    80,
    100,
    120
  ],
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "constant.numeric.padding.jeb",
        "settings": {
          "foreground": "#8AD2"
        }
      },
      {
        "scope": "constant.numeric.jeb",
        "settings": {
          "foreground": "#8ADF"
        }
      },
      {
        "scope": "string.jeb",
        "settings": {
          "foreground": "#FFFF"
        }
      },
      {
        "scope": "string.padding.jeb",
        "settings": {
          "foreground": "#FFFC"
        }
      },
      {
        "scope": "keyword.jeb",
        "settings": {
          "foreground": "#F848"
        }
      },
      {
        "scope": "comment.prelude.jeb",
        "settings": {
          "foreground": "#888"
        }
      }
    ]
  },
  "editor.wrappingIndent": "indent",
  "errorLens.enabledDiagnosticLevels": [
    "error"
  ],
  "errorLens.statusBarColorsEnabled": true,
  "files.associations": {
    "*.jeb": "jeb85",
    "*.jeb85": "jeb85",
    "*.sh": "jeb85",
    "*.z85": "jeb85"
  },
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 32768,
  "files.trimTrailingWhitespace": true,
  "git.autofetch": true,
  "rust-analyzer.cargo.features": "all",
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.diagnostics.disabled": [
    "E0728"
  ]
}
